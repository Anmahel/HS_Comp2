# =============================================================================
# HC_comp — Environment Configuration
# =============================================================================

# Flask Environment: 'development' | 'testing' | 'production'
FLASK_ENV=development
PORT=5000
# HOST=0.0.0.0   # Uncomment to bind all interfaces (default: 127.0.0.1)

# Secret key used to sign auth tokens (itsdangerous).
# MUST be set to a long random value in production — startup fails otherwise.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=hc-comp-secret-key-2026-production

# Database Configuration:
# Development / Testing (SQLite default):
# DATABASE_URL=sqlite:///hc_comp.db
#
# Production (MariaDB / MySQL):
# DATABASE_URL=mysql+pymysql://hc_user:strong_password@localhost:3306/hc_comp

# Security / Administrative Seed Protection
# Required in production to authorize /api/seed calls via header X-Admin-Key
ADMIN_SEED_SECRET=your_super_secret_admin_seed_token_2026

# Initial administrator account (created automatically at first seed).
# In production, ADMIN_PASSWORD is REQUIRED — startup fails without it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Frontend Configuration
VITE_API_URL=http://localhost:5000